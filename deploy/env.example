# Giá trị cần đặt trong ~/supabase/.env (file .env của docker-compose Supabase chính thức).
# Sao chép các dòng này vào .env (ghi đè biến cùng tên), rồi điền giá trị thật. KHÔNG commit file .env.
# Sinh khoá:  ./deploy/gen-keys.sh   (in JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY)

############ Bí mật (bắt buộc đổi) ############
POSTGRES_PASSWORD=
JWT_SECRET=                 # >= 32 ký tự
ANON_KEY=                   # JWT role=anon ký bằng JWT_SECRET; dán vào assets/js/config.js
SERVICE_ROLE_KEY=           # JWT role=service_role; TUYỆT ĐỐI không đưa vào site
SECRET_KEY_BASE=            # openssl rand -hex 32
VAULT_ENC_KEY=              # openssl rand -hex 16
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

############ URL ############
SITE_URL=https://games.example.com
API_EXTERNAL_URL=https://api.example.com
SUPABASE_PUBLIC_URL=https://api.example.com
# Trang được phép nhận token sau khi đăng nhập OAuth (phải trùng URL trang chủ, ngăn cách bằng dấu phẩy)
ADDITIONAL_REDIRECT_URLS=https://games.example.com/,https://games.example.com/index.html

############ Đăng ký / email ############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true     # true khi chưa có SMTP; có SMTP thì false và điền SMTP_*
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
# SMTP_SENDER_NAME=IT Games

############ Đăng nhập Google (OAuth) ############
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorized redirect URI: https://api.example.com/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

############ SSO Microsoft của trường (Entra ID / Azure AD) ############
# Entra admin center > App registrations > New registration
#   Redirect URI (Web): https://api.example.com/auth/v1/callback
#   Tạo Client secret; lấy Application (client) ID và Directory (tenant) ID.
# Chỉ tài khoản của trường: dùng tenant ID cụ thể (không dùng common/organizations).
GOTRUE_EXTERNAL_AZURE_ENABLED=false
GOTRUE_EXTERNAL_AZURE_CLIENT_ID=
GOTRUE_EXTERNAL_AZURE_SECRET=
GOTRUE_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
